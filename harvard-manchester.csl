<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0.2" and="symbol" et-al-use-first="3" demote-non-dropping-particle="never">
  <!-- This style was created with the Visual CSL Editor (https://editor.citationstyles.org/visualEditor/) -->
  <info>
    <title>Harvard Manchester</title>
    <author>
      <name>Adrian Kosikowski</name>
    </author>
    <author>
      <name>Kai Prince</name>
    </author>
    <contributor>
      <name>Lea Anderton</name>
    </contributor>
    <contributor>
      <name>David Hirst</name>
    </contributor>
    <contributor>
      <name>Dhruv Mistry</name>
    </contributor>
    <contributor>
      <name>Preenal Asher</name>
    </contributor>
    <updated>2025-03-18T11:43:30+00:00</updated>
  </info>
  <macro name="author">
    <choose>
      <if match="all" variable="author editor">
        <names variable="author" suffix=" ">
          <name delimiter="," suffix=" " and="text" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" initialize-with=". " name-as-sort-order="all"/>
        </names>
      </if>
      <else-if match="any" variable="editor">
        <names variable="editor">
          <name and="text" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" initialize-with=". " name-as-sort-order="all"/>
        </names>
      </else-if>
      <else>
        <names variable="author editor guest">
          <name and="text" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" initialize-with=". " name-as-sort-order="all"/>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="author-citation">
    <choose>
      <if match="all" variable="author editor">
        <names variable="author" suffix=" ">
          <name form="short" delimiter="," suffix=" " and="text" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" initialize-with=". "/>
        </names>
      </if>
      <else-if match="any" variable="editor">
        <names variable="editor">
          <name form="short" and="text" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" initialize-with=". "/>
        </names>
      </else-if>
      <else>
        <names variable="author editor guest">
          <name form="short" and="text" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" initialize-with=". "/>
        </names>
      </else>
    </choose>
  </macro>
  <macro name="year">
    <group>
      <date date-parts="year" form="text" variable="issued" prefix="(" suffix=").">
        <date-part name="year"/>
      </date>
    </group>
  </macro>
  <macro name="specific title">
    <group>
      <text variable="title" prefix=" '" suffix="', "/>
      <choose>
        <if match="any" variable="collection-title"/>
      </choose>
    </group>
  </macro>
  <macro name="title">
    <group suffix=",">
      <text variable="container-title" font-style="italic"/>
    </group>
    <choose>
      <if match="any" variable="collection-title">
        <text variable="collection-title" font-style="italic" prefix=": " suffix=". "/>
      </if>
      <else>
        <text value="" suffix=". "/>
      </else>
    </choose>
  </macro>
  <macro name="editions">
    <group delimiter=" ">
      <number variable="edition" form="ordinal"/>
      <text value="edn. "/>
    </group>
  </macro>
  <macro name="medium">
    <group prefix="[" suffix="]. ">
      <text variable="medium"/>
    </group>
  </macro>
  <macro name="publisher">
    <group delimiter=" ">
      <text variable="publisher-place" suffix=":"/>
      <text variable="publisher" suffix="."/>
    </group>
  </macro>
  <macro name="last update">
    <choose>
      <if type="post" match="any">
        <date variable="issued">
          <date-part name="hour" suffix=":"/>
          <date-part name="minute" suffix=", "/>
        </date>
      </if>
    </choose>
    <date variable="issued">
      <date-part name="day" form="numeric-leading-zeros" suffix=" "/>
      <date-part name="month"/>
    </date>
  </macro>
  <macro name="page number">
    <group>
      <label suffix=" " variable="page" form="short"/>
      <text variable="page" font-variant="normal" suffix="."/>
    </group>
  </macro>
  <macro name="access">
    <group delimiter=" ">
      <choose>
        <if match="any" variable="DOI">
          <text variable="DOI" prefix="https://doi.org/" suffix="."/>
        </if>
        <else-if match="any" variable="URL">
          <text value="Available at:"/>
          <text variable="URL"/>
        </else-if>
      </choose>
      <group prefix=" (" suffix=").">
        <text value="Accessed: "/>
        <date variable="accessed">
          <date-part name="day" form="numeric-leading-zeros" suffix=" "/>
          <date-part name="month" suffix=" "/>
          <date-part name="year"/>
        </date>
      </group>
    </group>
  </macro>
  <macro name="link">
    <!-- DOI preferred; only show accessed date for pure URL (no DOI) and web-like types -->
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/" suffix="."/>
      </if>
      <else-if variable="URL">
        <group delimiter=" ">
          <text value="Available at:"/>
          <text variable="URL"/>
          <choose>
            <if type="webpage post post-weblog report dataset legislation standard patent map interview software graphic figure personal_communication" match="any">
              <group prefix=" (" suffix=").">
                <text value="Accessed: "/>
                <date variable="accessed">
                  <date-part name="day" form="numeric-leading-zeros" suffix=" "/>
                  <date-part name="month" suffix=" "/>
                  <date-part name="year"/>
                </date>
              </group>
            </if>
          </choose>
        </group>
      </else-if>
    </choose>
  </macro>
  <!-- Medium brackets macro for specific resource types -->
  <macro name="medium-brackets">
    <choose>
      <if variable="type">
        <text variable="type" prefix="[" suffix="]"/>
      </if>
    </choose>
  </macro>
  <macro name="quoted-title-sentence">
    <choose>
      <if variable="title">
        <text variable="title" prefix="‘" suffix="’."/>
      </if>
    </choose>
  </macro>
  <!-- Quoted title without trailing period (for chapters, conference papers where punctuation follows) -->
  <macro name="quoted-title">
    <choose>
      <if variable="title">
        <text variable="title" prefix="‘" suffix="’"/>
      </if>
    </choose>
  </macro>
  <!-- Translator statement -->
  <macro name="translator">
    <choose>
      <if variable="translator">
        <names variable="translator" prefix="Translated by " suffix=".">
          <name and="text" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" initialize-with=". " name-as-sort-order="all"/>
        </names>
      </if>
    </choose>
  </macro>
  <macro name="title-shortened">
    <choose>
      <if match="any" variable="collection-title"/>
    </choose>
  </macro>
  <macro name="cite-locator">
    <group prefix=", ">
      <label variable="locator" form="short" suffix=" "/>
      <text variable="locator"/>
    </group>
  </macro>
  <macro name="author-or-title-year">
    <choose>
      <if variable="author editor">
        <group delimiter=" ">
          <text macro="author"/>
          <text macro="year"/>
        </group>
      </if>
      <else>
        <group delimiter=" ">
          <text variable="title" font-style="italic"/>
          <choose>
            <if variable="issued">
              <date variable="issued" prefix="(" suffix=").">
                <date-part name="year"/>
              </date>
            </if>
            <else>
              <text value="(no date)."/>
            </else>
          </choose>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="front-matter">
    <!-- Author(s)/Corporate or Title, then (Year).  -->
    <choose>
      <if variable="author" match="any">
        <group delimiter=" ">
          <names variable="author">
            <name and="text" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" initialize-with=". " name-as-sort-order="all"/>
          </names>
          <choose>
            <if variable="issued">
              <date variable="issued" prefix="(" suffix=").">
                <date-part name="year"/>
              </date>
            </if>
            <else>
              <text value="(no date)."/>
            </else>
          </choose>
        </group>
      </if>
      <else-if variable="editor">
        <group delimiter=" ">
          <names variable="editor">
            <name and="text" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" initialize-with=". " name-as-sort-order="all"/>
          </names>
          <choose>
            <if variable="editor" match="any">
              <choose>
                <if is-numeric="editor" match="none">
                  <text value="(ed.)"/>
                </if>
              </choose>
            </if>
          </choose>
          <choose>
            <if variable="issued">
              <date variable="issued" prefix="(" suffix=").">
                <date-part name="year"/>
              </date>
            </if>
            <else>
              <text value="(no date)."/>
            </else>
          </choose>
        </group>
      </else-if>
      <else>
        <group delimiter=" ">
          <text variable="title" font-style="italic"/>
          <choose>
            <!-- Suppress year for legislation where year is embedded in title -->
            <if type="legislation" match="any">
              <text value=""/>
            </if>
            <else>
              <choose>
                <if variable="issued">
                  <date variable="issued" prefix="(" suffix=").">
                    <date-part name="year"/>
                  </date>
                </if>
                <else>
                  <text value="(no date)."/>
                </else>
              </choose>
            </else>
          </choose>
        </group>
      </else>
    </choose>
  </macro>
  <citation delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" et-al-subsequent-min="4" et-al-subsequent-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-givenname="true" givenname-disambiguation-rule="all-names" collapse="year" after-collapse-delimiter=", ">
    <sort>
      <key macro="author"/>
      <key macro="year"/>
    </sort>
    <layout delimiter="; " prefix="(" suffix=")">
      <choose>
        <if match="any" type="legislation entry-encyclopedia post-weblog">
          <choose>
            <if match="any" variable="title">
              <text variable="title" font-style="italic"/>
            </if>
          </choose>
        </if>
        <else>
          <choose>
            <if match="any" variable="author editor">
              <text macro="author-citation" suffix=", "/>
            </if>
            <else-if match="any" variable="title">
              <text variable="title" font-style="italic" suffix=", "/>
            </else-if>
          </choose>
        </else>
      </choose>
      <choose>
        <if match="any" type="legislation entry-encyclopedia post-weblog">
          <text value=""/>
        </if>
        <else-if match="any" variable="issued">
          <date variable="issued"><date-part name="year"/></date>
        </else-if>
        <else>
          <text value="no date"/>
        </else>
      </choose>
      <choose>
        <if variable="locator">
          <text macro="cite-locator"/>
        </if>
      </choose>
    </layout>
  </citation>
  <bibliography delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" et-al-subsequent-min="4" et-al-subsequent-use-first="1" entry-spacing="0" hanging-indent="true">
    <sort>
      <key macro="author"/>
      <key macro="front-matter"/>
      <key variable="title"/>
    </sort>
  <layout>
      <!-- Front matter: Authors (Year). OR Title (Year). when no author/editor -->
      <text macro="front-matter"/>
      <text value=" "/>
      <choose>
    <!-- Journal Article Pattern -->
        <if type="article-journal" match="any">
          <group delimiter=" ">
            <text macro="quoted-title-sentence"/>
            <group delimiter=" ">
              <text variable="container-title" font-style="italic" suffix=","/>
              <group delimiter="" suffix=",">
                <text variable="volume"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
              <group delimiter="">
                <label variable="page" form="short" suffix=" "/>
                <text variable="page" suffix="."/>
              </group>
              <text macro="link"/>
            </group>
          </group>
        </if>
    <!-- Book Pattern -->
        <else-if type="book" match="any">
          <group delimiter=" ">
            <choose>
              <if variable="author editor" match="any">
                <text variable="title" font-style="italic" suffix="."/>
                <choose>
                  <if variable="collection-title">
                    <text variable="collection-title" font-style="italic" prefix=" " suffix="."/>
                  </if>
                </choose>
              </if>
              <else/>
            </choose>
            <choose>
              <if variable="edition">
                <group delimiter=" ">
                  <number variable="edition" form="ordinal"/>
                  <text value="edn."/>
                </group>
              </if>
            </choose>
            <text macro="translator"/>
            <choose>
              <if variable="publisher">
                <group delimiter=": " suffix=".">
                  <text variable="publisher-place"/>
                  <text variable="publisher"/>
                </group>
              </if>
            </choose>
            <text macro="link"/>
          </group>
        </else-if>
    <!-- Chapter Pattern -->
        <else-if type="chapter" match="any">
          <group delimiter=" ">
            <text macro="quoted-title" suffix=","/>
            <group prefix=" in " delimiter=" ">
              <names variable="editor">
                <name and="text" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" initialize-with=". " name-as-sort-order="all"/>
              </names>
              <choose>
                <if variable="editor" match="any">
                  <label variable="editor" form="short" prefix=" (" suffix=")"/>
                </if>
              </choose>
              <text variable="container-title" font-style="italic" suffix="."/>
            </group>
            <choose>
              <if variable="collection-title">
                <text variable="collection-title" font-style="italic" suffix="."/>
              </if>
            </choose>
            <choose>
              <if variable="publisher">
                <group delimiter=": " suffix=",">
                  <text variable="publisher-place"/>
                  <text variable="publisher"/>
                </group>
              </if>
            </choose>
            <group delimiter=" ">
              <label variable="page" form="short" suffix=" "/>
              <text variable="page" suffix="."/>
            </group>
            <text macro="link"/>
          </group>
        </else-if>
        <!-- Thesis Pattern -->
        <else-if type="thesis" match="any">
          <group delimiter=" ">
            <choose>
              <if variable="author editor" match="any">
                <text variable="title" font-style="italic" suffix="."/>
              </if>
              <else>
                <text variable="title" font-style="italic" suffix="."/>
              </else>
            </choose>
            <group delimiter=", " suffix=".">
              <text variable="genre"/>
              <text variable="publisher"/>
            </group>
            <text macro="link"/>
          </group>
        </else-if>
        <!-- Report Pattern -->
        <else-if type="report" match="any">
          <group delimiter=" ">
            <choose>
              <if variable="author editor" match="any">
                <text variable="title" font-style="italic" suffix="."/>
              </if>
              <else>
                <text variable="title" font-style="italic" suffix="."/>
              </else>
            </choose>
            <group delimiter=": " suffix=".">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
            </group>
            <choose>
              <if variable="number">
                <text variable="number" prefix="(" suffix=")."/>
              </if>
            </choose>
            <text macro="link"/>
          </group>
        </else-if>
        <!-- Webpage Pattern -->
        <else-if type="webpage" match="any">
          <group delimiter=" ">
            <choose>
              <if variable="author editor" match="any">
                <text variable="title" font-style="italic" suffix="."/>
              </if>
              <else>
                <text variable="title" font-style="italic" suffix="."/>
              </else>
            </choose>
            <text macro="link"/>
          </group>
        </else-if>
        <!-- Dataset Pattern -->
        <else-if type="dataset" match="any">
            <group delimiter=" ">
              <text variable="title" font-style="italic" suffix="."/>
              <choose>
                <if variable="publisher">
                  <group delimiter=": " suffix=".">
                    <text variable="publisher-place"/>
                    <text variable="publisher"/>
                  </group>
                </if>
              </choose>
              <text macro="link"/>
            </group>
        </else-if>
    <!-- Conference Paper Pattern -->
        <else-if type="paper-conference" match="any">
          <group delimiter=" ">
      <text macro="quoted-title-sentence"/>
            <group prefix="In: " delimiter=" ">
              <text variable="container-title" font-style="italic" suffix="."/>
              <choose>
                <if variable="event" match="any">
                  <text variable="event" suffix="."/>
                </if>
              </choose>
            </group>
            <choose>
              <if variable="publisher">
                <group delimiter=": " suffix=",">
                  <text variable="publisher-place"/>
                  <text variable="publisher"/>
                </group>
              </if>
            </choose>
            <group delimiter=" ">
              <label variable="page" form="short" suffix=" "/>
              <text variable="page" suffix="."/>
            </group>
            <text macro="link"/>
          </group>
        </else-if>
        <!-- Standard Pattern -->
        <else-if type="standard" match="any">
          <group delimiter=" ">
            <text variable="title" font-style="italic" suffix="."/>
            <choose>
              <if variable="number">
                <text variable="number" prefix="(" suffix=")."/>
              </if>
            </choose>
            <choose>
              <if variable="publisher">
                <group delimiter=": " suffix=".">
                  <text variable="publisher-place"/>
                  <text variable="publisher"/>
                </group>
              </if>
            </choose>
            <text macro="link"/>
          </group>
        </else-if>
        <!-- Legislation Pattern -->
        <else-if type="legislation" match="any">
          <group delimiter=" ">
            <!-- Title already printed in front-matter (with year embedded); suppress duplicate here -->
            <choose>
              <if variable="authority">
                <text variable="authority" suffix="."/>
              </if>
            </choose>
            <text macro="link"/>
          </group>
        </else-if>
        <!-- Patent Pattern -->
        <else-if type="patent" match="any">
          <group delimiter=" ">
            <text variable="title" font-style="italic" suffix="."/>
            <choose>
              <if variable="number">
                <text variable="number" prefix="Patent no. " suffix="."/>
              </if>
            </choose>
            <text macro="link"/>
          </group>
        </else-if>
  <!-- Interview Pattern -->
        <else-if type="interview" match="any">
          <group delimiter=" ">
            <choose>
              <if variable="title">
                <text macro="quoted-title" suffix=","/>
              </if>
              <else>
                <text value="Interview,"/>
              </else>
            </choose>
            <text macro="medium-brackets"/>
            <choose>
              <if variable="interviewer">
                <names variable="interviewer" prefix="Interviewed by " suffix=".">
                  <name and="text" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="1" initialize-with=". " name-as-sort-order="all"/>
                </names>
              </if>
            </choose>
            <text macro="link"/>
          </group>
        </else-if>
        <!-- Software Pattern -->
        <else-if type="software" match="any">
          <group delimiter=" ">
            <text variable="title" font-style="italic"/>
            <choose>
              <if variable="version">
                <text variable="version" prefix=" [" suffix="]"/>
              </if>
            </choose>
            <text macro="medium-brackets"/>
            <choose>
              <if variable="publisher">
                <group delimiter=": " suffix=".">
                  <text variable="publisher-place"/>
                  <text variable="publisher"/>
                </group>
              </if>
            </choose>
            <text macro="link"/>
          </group>
        </else-if>
        <!-- Fallback Pattern -->
        <else>
          <group delimiter=" ">
            <!-- Only print title here if an author/editor existed (avoids duplicate when title already in front-matter for no-author items) -->
            <choose>
              <if variable="author editor" match="any">
                <text variable="title" font-style="italic" suffix="."/>
              </if>
              <else/>
            </choose>
            <choose>
              <if variable="container-title">
                <group delimiter=", ">
                  <text variable="container-title" font-style="italic"/>
                  <group delimiter=" ">
                    <text variable="volume"/>
                    <text variable="issue" prefix="(" suffix=")"/>
                  </group>
                  <group delimiter=" ">
                    <label variable="page" form="short" suffix=" "/>
                    <text variable="page"/>
                  </group>
                </group>
              </if>
            </choose>
            <choose>
              <if variable="publisher">
                <group delimiter=": " suffix=".">
                  <text variable="publisher-place"/>
                  <text variable="publisher"/>
                </group>
              </if>
            </choose>
            <text macro="link"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
